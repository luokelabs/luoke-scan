{
  "about": "~/.ssh 是链到别处的链接：私钥和文件夹权限不看；authorized_keys、rc 顺着链接照报",
  "case": "rules/exposure/ssh-linked-dir",
  "steps": [
    {
      "exit": 0,
      "run": [
        "luoke-scan",
        "update",
        "--data",
        "$FIXTURE/data",
        "--tool-dir",
        "$FIXTURE/tools",
        "--force"
      ],
      "stdout": [
        "病毒库更新好了（daily 27000）"
      ]
    },
    {
      "exit": 0,
      "json": {
        "findings": [
          {
            "category": "persistence",
            "evidence": {
              "how": "是你自己写的就留着；不是的话打开看看它做了什么，不认得就删掉"
            },
            "path": "~/.ssh/rc",
            "rule": "exposure.ssh-rc",
            "severity": "medium",
            "title": "每次有人用 SSH 登录这台 Mac，都会先运行 ~/.ssh/rc",
            "verdict": "info"
          },
          {
            "category": "posture",
            "evidence": {
              "how": "认得每一把就留着；不认得的从 ~/.ssh/authorized_keys 里删掉那一行",
              "keys": "1"
            },
            "key": "~/.ssh|ssh-ed25519 AAAAexample1 laptop",
            "path": "~/.ssh/authorized_keys",
            "rule": "exposure.ssh-authorized",
            "severity": "low",
            "title": "有 1 把钥匙能用 SSH 登录这台 Mac（「远程登录」开着时）",
            "verdict": "info"
          }
        ],
        "finishedAt": "2026-10-20T12:00:00Z",
