  "actions": [
    {"id": "review", "by": "finder", "why": "用户自己的文件，只有用户知道哪些还要：在访达里按大小、日期排了自己挑"},
    {"id": "empty-trash", "by": "finder", "why": "清倒废纸篓；清了放不回去"},
    {"id": "remove-download", "by": "finder", "why": "云盘里的文件右键「移除下载」：本机那一份腾出来，云端的还在，再点会重新下载"},
    {"id": "manage-backups", "by": "finder", "why": "访达里选中接着的设备 →「管理备份」，或「储存空间」里的「iOS 文件」，一份一份删旧的设备备份"},
    {"id": "storage-settings", "by": "system-settings", "pane": "storage", "why": "系统设置 → 通用 → 储存空间：按应用列出占用，信息、邮件、照片、iOS 文件、废纸篓各有自己的清单，能按大小看附件、逐个删"},
    {"id": "icloud-optimize", "by": "system-settings", "pane": "icloud", "why": "iCloud 的「优化 Mac 储存空间」：空间紧时系统自己把旧文件只留在云端"},
    {"id": "messages-keep", "by": "app", "app": "信息", "bundleId": "com.apple.MobileSMS", "why": "信息 → 设置 → 通用 →「保留信息」：从永久改成一年或 30 天，更早的聊天和附件由系统删掉"},
    {"id": "photos-optimize", "by": "app", "app": "照片", "bundleId": "com.apple.Photos", "why": "照片 → 设置 → iCloud →「优化 Mac 储存空间」：原件留在 iCloud，本机留小图；要开着 iCloud 照片"},
    {"id": "mail-attachments", "by": "app", "app": "邮件", "bundleId": "com.apple.mail", "why": "邮件里选中邮件 → 信息 →「移除附件」；账户设置里「下载附件」改成「最近」或「无」，不再把全部附件下到本机"},
    {"id": "xcode-archives", "by": "app", "app": "Xcode", "bundleId": "com.apple.dt.Xcode", "why": "Xcode → Window → Organizer → Archives：删掉不再需要的旧归档"},
    {"id": "xcode-simulators", "by": "command", "command": "xcrun simctl delete unavailable", "why": "删掉当前 Xcode 已经用不了的模拟器设备；还能用的不动"},
    {"id": "docker-prune", "by": "command", "command": "docker system prune", "why": "清掉不用的镜像、容器和构建缓存；数据卷不动"},
    {"id": "ollama-rm", "by": "command", "command": "ollama rm <model>", "why": "`<model>` 是要用户自己填的模型名，照原样跑不成：先 `ollama list` 看有哪些模型，再 `ollama rm <名字>` 删掉用不到的"},
    {"id": "huggingface-delete-cache", "by": "command", "command": "huggingface-cli delete-cache", "why": "列出下载过的模型和数据集，选了删"},
    {"id": "lm-studio-models", "by": "app", "app": "LM Studio", "why": "在 LM Studio 的模型列表里删掉用不到的"}
