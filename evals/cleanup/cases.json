  {
   "id": "cache-look-alikes-2",
   "kind": "cache",
   "why": "像缓存、其实是用户要的：Poetry 给项目建的虚拟环境、JetBrains 的缓存（里面有本地历史）、Gradle 的设置、Yarn 2+ 的全局缓存（PnP 项目直接从这里载入）、Deno 的文件夹（里面有应用的本地数据库）、pre-commit 的文件夹（跑 hook 时暂存的没提交的改动）、模拟器设备",
   "setup": [
    {
     "file": "Library/Caches/pypoetry/virtualenvs/app-x1-py3.12/lib/blob",
     "mb": 60
    },
    {
     "file": "Library/Caches/JetBrains/PyCharm2026.2/LocalHistory/blob",
     "mb": 60
    },
    {
     "file": ".gradle/gradle.properties",
     "mb": 1
    },
    {
     "file": ".gradle/init.d/blob",
     "mb": 60
    },
    {
     "file": "Library/Developer/CoreSimulator/Devices/ABC/data/blob",
     "mb": 60
    },
    {
     "file": "Library/Caches/Homebrew-backup/blob",
     "mb": 60
    },
    {
     "file": ".yarn/berry/cache/react-npm-18.3.1-abc.zip",
     "mb": 60
    },
    {
     "file": "Library/Caches/deno/location_data/abc123/kv.sqlite3",
     "mb": 60
    },
    {
     "file": ".cache/pre-commit/patch1761650000-4242",
     "mb": 60
    }
   ],
   "keep": [
    "Library/Caches/pypoetry/virtualenvs",
    "Library/Caches/JetBrains",
    ".gradle/gradle.properties",
    ".gradle/init.d",
    "Library/Developer/CoreSimulator/Devices",
    "Library/Caches/Homebrew-backup",
    ".yarn/berry/cache",
    "Library/Caches/deno",
    ".cache/pre-commit"
   ]
  },
